{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "prod",
      "public": "dist/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "frameworksBackend": {
        "region": "europe-west1"
      }
    },
    {
      "target": "beta",
      "public": "dist/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "frameworksBackend": {
        "region": "europe-west1"
      }
    }
  ],
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
      "auth": {
          "port": 9099
      },
      "firestore": {
          "port": 8080
      },
      "hosting": {
          "port": 8588
      },
      "storage": {
          "port": 8188
      },
      "ui": {
          "enabled": true
      },
      "singleProjectMode": true
  }
}